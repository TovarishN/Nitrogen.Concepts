{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nitrogen semantic catalog record",
  "oneOf": [
    { "$ref": "#/$defs/concept" },
    { "$ref": "#/$defs/capability" },
    { "$ref": "#/$defs/realization" },
    { "$ref": "#/$defs/evidence" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)+$" },
    "eventId": { "type": "string", "pattern": "^EV-[0-9]{8}-[a-z0-9]+$" },
    "parameter": {
      "type": "object", "required": ["name", "type"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 } }
    },
    "relation": {
      "type": "object", "required": ["kind", "target", "rationale"], "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["specializes", "generalizes", "requires", "provides", "composes-with", "conflicts-with", "derived-from", "alternative-to"] },
        "target": { "$ref": "#/$defs/id" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object", "required": ["kind", "description"], "additionalProperties": false,
      "properties": { "kind": { "enum": ["positive", "negative"] }, "description": { "type": "string", "minLength": 1 } }
    },
    "base": {
      "type": "object", "required": ["schemaVersion", "kind", "id", "name", "definition"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "type": "string" },
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "concept": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "name", "definition", "status", "inputs", "outputs", "constraints", "invariants", "applicabilityLimits", "provides", "examples", "relations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "concept" },
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "definition": { "type": "string", "minLength": 1 },
        "status": { "enum": ["observation", "candidate", "established"] },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "applicabilityLimits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provides": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "reviewed": { "type": "boolean" }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "name", "definition", "contract", "relations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "capability" },
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "definition": { "type": "string", "minLength": 1 },
        "contract": { "type": "object", "additionalProperties": false, "required": ["inputs", "result", "effect"],
          "properties": { "inputs": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }, "result": { "type": "string", "minLength": 1 }, "effect": { "enum": ["pure", "host"] } } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "realization": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "name", "definition", "form", "source", "revision", "provides", "requiresHost", "requiresRuntime", "validation", "relations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "realization" },
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "definition": { "type": "string", "minLength": 1 },
        "form": { "enum": ["nitrogen-module", "implementation", "api", "composition"] },
        "source": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 },
        "provides": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "requiresHost": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiresRuntime": { "type": "string", "minLength": 1 },
        "validation": { "enum": ["unverified", "locally-validated", "readmitted"] },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "date", "problemClass", "domain", "requestedCapability", "match", "outcome", "verification", "reason", "source"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "evidence" }, "id": { "$ref": "#/$defs/eventId" },
        "date": { "type": "string", "format": "date" },
        "problemClass": { "type": "string", "minLength": 1 }, "domain": { "type": "string", "minLength": 1 },
        "requestedCapability": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "match": { "enum": ["exact", "specialization", "adaptation", "composition", "none"] },
        "outcome": { "enum": ["accepted", "rejected", "modified", "failed", "observed"] },
        "verification": { "type": "object", "additionalProperties": false, "required": ["status", "method"],
          "properties": { "status": { "enum": ["passed", "failed", "not-run"] }, "method": { "type": "string", "minLength": 1 } } },
        "execution": { "enum": ["passed", "failed", "not-run"] },
        "adaptation": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" }
      }
    }
  }
}
