#!/usr/bin/env bash
# Runs the Nitrogen language server built by tools/editors/build.sh; .vscode/settings.json points here.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
server="$root/artifacts/nitrogen/nitrogen.dll"
if [[ ! -f "$server" ]]; then
    echo "nitrogen: $server is missing; run tools/editors/build.sh --vscode" >&2
    exit 1
fi
exec dotnet "$server" "$@"
