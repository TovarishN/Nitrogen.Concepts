realization SemanticCatalog.EditorSupport composition
{
  name "Catalog editor support";
  definition "Self-contained VS Code and Rider plugins built by tools/editors/build.sh with nitrogen package. Each carries the catalog language and a portable Nitrogen server, run as dotnet nitrogen.dll lsp --config on the bundled nitrogen.json, so it works in any folder.";
  source "https://github.com/TovarishN/Nitrogen.Concepts/tree/f20dd5452977d957a19b4933dfa18c542f981fb0/tools/editors";
  revision "f20dd5452977d957a19b4933dfa18c542f981fb0";
  runtime ".NET 10 runtime with Nitrogen 2c7780681db0367d6e65dbb652c0a66f389c02ec; VS Code 1.90+ or Rider 2026.2";
  host "an editor that runs a language server over stdio";
  validation locally-validated;
  provides SemanticCatalog.EditRecords;
}
