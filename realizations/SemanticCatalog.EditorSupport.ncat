realization SemanticCatalog.EditorSupport composition
{
  name "Catalog editor support";
  definition "nitrogen lsp serving the catalog language from nitrogen.json, reached through the generic Nitrogen VS Code extension and a Rider plugin generated by tools/editors/build.sh. Grammar clause checks are not shown in the editor.";
  source "https://github.com/TovarishN/Nitrogen.Concepts/tree/68ea508c57c0f2a5f5cc2ce61b33817e9117d20d/tools/editors";
  revision "68ea508c57c0f2a5f5cc2ce61b33817e9117d20d";
  runtime ".NET 10 with Nitrogen 7f337d96521a120f4f15bcfa95526f8f9c612ac8; VS Code 1.90+ or Rider 2026.2";
  host "an editor that runs a language server over stdio";
  validation unverified;
  provides SemanticCatalog.EditRecords;
}
