realization Nitrogen.PluginPackager implementation
{
  name "Nitrogen plugin packager";
  definition "nitrogen package in Nitrogen.Cli: stages a language bundle and builds a .vsix with npm and vsce and a Rider plugin ZIP with Gradle. The plugins run the bundled server with the user's .NET 10 runtime.";
  source "https://github.com/TovarishN/Nitrogen/tree/53b32f1fb10d0daf9ae3c297f0e78e2f373c2012";
  revision "53b32f1fb10d0daf9ae3c297f0e78e2f373c2012";
  runtime ".NET 10; the nitrogen tool 0.1.0 (nitrogen package)";
  host "npm for VS Code packages";
  host "Gradle and JDK 25 for Rider packages";
  validation locally-validated;
  provides LanguageWorkbench.PackageEditorPlugins;
  relation requires LanguageWorkbench.ServeLanguage "Each plugin runs nitrogen lsp --config on its bundled language.";
}
