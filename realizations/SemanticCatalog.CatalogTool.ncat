realization SemanticCatalog.CatalogTool implementation
{
  name "Catalog validator and indexer";
  definition "The tools/Catalog command-line tool: loads .ncat records written in language/Catalog.ngr into one Nitrogen project, applies catalog-wide and base-revision rules, and writes or checks index.json.";
  source "https://github.com/TovarishN/Nitrogen.Concepts/tree/232718de43453791b61925b178147626725ae4ae/tools/Catalog";
  revision "232718de43453791b61925b178147626725ae4ae";
  runtime ".NET 10 with Nitrogen.Runtime and Nitrogen.Generator 0.1.0 from GitHub Packages";
  host "read access to a catalog checkout";
  host "write access to index.json (index --write only)";
  validation locally-validated;
  provides SemanticCatalog.ValidateRecords;
  provides SemanticCatalog.BuildCapabilityIndex;
  provides SemanticCatalog.CheckCatalogHistory;
  relation requires LanguageWorkbench.ParseWithGrammar "Records are parsed with language/Catalog.ngr through the Nitrogen generator.";
  relation requires LanguageWorkbench.BindNames "Cross-record IDs are resolved by Nitrogen binding (NB0001, NB0003).";
  relation requires LanguageWorkbench.CheckSemantics "Clause checks CA0001-CA0005 are grammar checks evaluated by ProjectSemantics.";
}
