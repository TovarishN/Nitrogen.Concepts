realization Nitrogen.LanguageCore implementation
{
  name "Nitrogen language core";
  definition "Nitrogen.Grammar, Nitrogen.Generator, and Nitrogen.Runtime: .ngr grammars compiled to parsers and typed views, Project binding, ProjectSemantics checks, HirLowering, and HirEvaluator. Execution covers the finite numeric HIR slice; other results need a domain executor such as Nitrogen.Geometry's.";
  source "https://github.com/TovarishN/Nitrogen/tree/2c7780681db0367d6e65dbb652c0a66f389c02ec";
  revision "2c7780681db0367d6e65dbb652c0a66f389c02ec";
  runtime ".NET 10";
  host "host operation bindings for execution only";
  validation locally-validated;
  provides LanguageWorkbench.ParseWithGrammar;
  provides LanguageWorkbench.BindNames;
  provides LanguageWorkbench.CheckSemantics;
  provides LanguageWorkbench.LowerToTypedHir;
  provides LanguageWorkbench.ExecuteHostOperation;
}
